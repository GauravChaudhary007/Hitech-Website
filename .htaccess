# HiTech website: Apache config (shared hosting / cPanel / any Apache with .htaccess allowed).
# Upload the whole folder contents to the web root (public_html). No build step is needed.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Optional: force HTTPS. Uncomment once the SSL certificate is installed.
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Never serve build tooling, docs or config files
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(_build|docs)(/|$) - [F,L]
  RewriteRule ^(package\.json|README\.md|\.gitignore)$ - [F,L]
  RewriteRule ^lead-endpoint/(README\.md|check\.mjs)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

# Old site (PHP) links: send visitors and search engines to the matching new page (301).
# Matches on words in the old file name; anything else ending in .php goes to the home page.
<IfModule mod_rewrite.c>
  RewriteRule ^lead-endpoint/ - [L]
  RewriteRule ^chat/ /live-support.html [NC,R=301,QSD,L]
  RewriteRule ^swastik-accounting-software(/|$) /product-swastik.html [NC,R=301,L]
  RewriteRule ^files/[^/]*swastik[^/]*\.pdf$ /product-swastik.html [NC,R=301,L]
  RewriteRule ^files/ /products.html [NC,R=301,L]
  RewriteRule ^(.*/)?[^/]*(live-?support|helpdesk|ticket)[^/]*\.php$ /live-support.html [NC,R=301,NE,L]
  RewriteRule ^(.*/)?[^/]*(myswastik|swastik-?online)[^/]*\.php$ /product-myswastikonline.html [NC,R=301,NE,L]
  RewriteRule ^(.*/)?[^/]*(swastik-?pos|pos-?software|point-of-sale|retail)[^/]*\.php$ /product-pos.html [NC,R=301,NE,L]
  RewriteRule ^(.*/)?[^/]*(restaurant|cafe|hotel-?pos)[^/]*\.php$ /product-restaurant.html [NC,R=301,NE,L]
  RewriteRule ^(.*/)?[^/]*(pharma)[^/]*\.php$ /product-pharmasoft.html [NC,R=301,NE,L]
  RewriteRule ^(.*/)?[^/]*(hospitality|ezee|frontdesk|hotel)[^/]*\.php$ /products.html#ezee [NC,R=301,NE,L]
  RewriteRule ^(.*/)?[^/]*(avocare|hospital|clinic|health)[^/]*\.php$ /product-avocare.html [NC,R=301,NE,L]
  RewriteRule ^(.*/)?[^/]*(bizant|mobile|sfa|sales-?force|field)[^/]*\.php$ /product-bizant.html [NC,R=301,NE,L]
  RewriteRule ^(.*/)?[^/]*(swastik|accounting|billing|inventory)[^/]*\.php$ /product-swastik.html [NC,R=301,NE,L]
  RewriteRule ^(.*/)?[^/]*(tivora|erp)[^/]*\.php$ /tivora.html [NC,R=301,NE,L]
  RewriteRule ^(.*/)?[^/]*(partner|dealer|reseller|distributor|channel)[^/]*\.php$ /partners.html [NC,R=301,NE,L]
  RewriteRule ^(.*/)?[^/]*(client|customer|testimonial)[^/]*\.php$ /index.html#clients [NC,R=301,NE,L]
  RewriteRule ^(.*/)?[^/]*(about|company|profile|team)[^/]*\.php$ /about.html [NC,R=301,NE,L]
  RewriteRule ^(.*/)?[^/]*(career|job|vacanc|recruit)[^/]*\.php$ /careers.html [NC,R=301,NE,L]
  RewriteRule ^(.*/)?[^/]*(contact|enquiry|inquiry|demo)[^/]*\.php$ /contact.html [NC,R=301,NE,L]
  RewriteRule ^(.*/)?[^/]*(support|download|training)[^/]*\.php$ /support.html [NC,R=301,NE,L]
  RewriteRule ^(.*/)?[^/]*(service|solution|custom|software-?dev|web-?dev|ecommerce|e-commerce|mobile-?app)[^/]*\.php$ /solutions.html [NC,R=301,NE,L]
  RewriteRule ^(.*/)?[^/]*(product)[^/]*\.php$ /products.html [NC,R=301,NE,L]
  RewriteRule ^(.*/)?index\.php$ / [NC,R=301,L]
  RewriteRule \.php$ / [NC,R=301,L]
</IfModule>
