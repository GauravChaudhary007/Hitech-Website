# HiTech website: nginx server block example. Adjust server_name, root and the PHP socket.
# Static site plus one PHP file (lead-endpoint/lead.php) that emails inquiries.

server {
    listen 80;
    server_name www.hitechnepal.com.np hitechnepal.com.np;
    root /var/www/hitech-website;
    index index.html;

    # After installing the SSL certificate, redirect to HTTPS instead of serving over port 80.
    # return 301 https://www.hitechnepal.com.np$request_uri;

    error_page 404 /404.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/xml;

    location ~ ^/(_build|docs)/ { return 404; }
    location ~ ^/(package\.json|README\.md|nginx\.conf\.example)$ { return 404; }
    location ~ ^/lead-endpoint/(README\.md|check\.mjs)$ { return 404; }


    # Old site (PHP) links: 301 to the matching new page. Keep lead.php working (exact match below wins).
    location ~* ^/chat/ { return 301 /live-support.html; }
    location ~* ^/swastik-accounting-software(/|$) { return 301 /product-swastik.html; }
    location ~* ^/files/[^/]*swastik[^/]*\.pdf$ { return 301 /product-swastik.html; }
    location ~* ^/files/ { return 301 /products.html; }
    location ~* ^/(?:.*/)?[^/]*(?:live-?support|helpdesk|ticket)[^/]*\.php$ { return 301 /live-support.html; }
    location ~* ^/(?:.*/)?[^/]*(?:myswastik|swastik-?online)[^/]*\.php$ { return 301 /product-myswastikonline.html; }
    location ~* ^/(?:.*/)?[^/]*(?:swastik-?pos|pos-?software|point-of-sale|retail)[^/]*\.php$ { return 301 /product-pos.html; }
    location ~* ^/(?:.*/)?[^/]*(?:restaurant|cafe|hotel-?pos)[^/]*\.php$ { return 301 /product-restaurant.html; }
    location ~* ^/(?:.*/)?[^/]*(?:pharma)[^/]*\.php$ { return 301 /product-pharmasoft.html; }
    location ~* ^/(?:.*/)?[^/]*(?:hospitality|ezee|frontdesk|hotel)[^/]*\.php$ { return 301 /products.html#ezee; }
    location ~* ^/(?:.*/)?[^/]*(?:avocare|hospital|clinic|health)[^/]*\.php$ { return 301 /product-avocare.html; }
    location ~* ^/(?:.*/)?[^/]*(?:bizant|mobile|sfa|sales-?force|field)[^/]*\.php$ { return 301 /product-bizant.html; }
    location ~* ^/(?:.*/)?[^/]*(?:swastik|accounting|billing|inventory)[^/]*\.php$ { return 301 /product-swastik.html; }
    location ~* ^/(?:.*/)?[^/]*(?:tivora|erp)[^/]*\.php$ { return 301 /tivora.html; }
    location ~* ^/(?:.*/)?[^/]*(?:partner|dealer|reseller|distributor|channel)[^/]*\.php$ { return 301 /partners.html; }
    location ~* ^/(?:.*/)?[^/]*(?:client|customer|testimonial)[^/]*\.php$ { return 301 /index.html#clients; }
    location ~* ^/(?:.*/)?[^/]*(?:about|company|profile|team)[^/]*\.php$ { return 301 /about.html; }
    location ~* ^/(?:.*/)?[^/]*(?:career|job|vacanc|recruit)[^/]*\.php$ { return 301 /careers.html; }
    location ~* ^/(?:.*/)?[^/]*(?:contact|enquiry|inquiry|demo)[^/]*\.php$ { return 301 /contact.html; }
    location ~* ^/(?:.*/)?[^/]*(?:support|download|training)[^/]*\.php$ { return 301 /support.html; }
    location ~* ^/(?:.*/)?[^/]*(?:service|solution|custom|software-?dev|web-?dev|ecommerce|e-commerce|mobile-?app)[^/]*\.php$ { return 301 /solutions.html; }
    location ~* ^/(?:.*/)?[^/]*(?:product)[^/]*\.php$ { return 301 /products.html; }
    location ~* \.php$ { return 301 /; }

    location / {
        try_files $uri $uri/ =404;
    }

    location ~* \.(css|js)$ { expires 7d; }
    location ~* \.(png|jpg|jpeg|svg|mp4)$ { expires 30d; }
    location ~* \.html$ { expires -1; }

    location = /lead-endpoint/lead.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php-fpm.sock;   # adjust to the server's PHP-FPM socket
    }
}
